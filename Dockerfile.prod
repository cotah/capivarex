# Production Dockerfile — uses gunicorn for multi-worker serving
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies needed for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files first (better layer caching)
COPY requirements.txt .

# Install dependencies + gunicorn
RUN pip install --no-cache-dir -r requirements.txt gunicorn

# Copy the rest of the application code
COPY . .

EXPOSE 8000

# Run with gunicorn (multi-worker, production-grade)
CMD ["gunicorn", "-c", "gunicorn_conf.py", "api.main:app"]
