# ===========================================
# SuperBot God - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to git!
# ===========================================

# OpenAI Configuration
OPENAI_API_KEY=sua_chave_openai_aqui

# Anthropic Configuration
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
CLAUDE_MODEL=claude-opus-4-5-20251101

# Perplexity / Sonar Configuration
SONAR_API_KEY=sua_chave_sonar_aqui

# GitHub Configuration
GITHUB_TOKEN=seu_token_github_aqui

# Telegram Configuration
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui
TELEGRAM_ADMIN_CHAT_ID=seu_chat_id_aqui

# Supabase Configuration
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua_chave_supabase_aqui

# JWT Configuration
JWT_SECRET_KEY=sua_chave_jwt_secreta_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Bot Credentials
BOT_EMAIL=seu_email_bot_aqui
BOT_PASSWORD=sua_senha_bot_aqui

# API Configuration
API_BASE_URL=http://localhost:8000

# Weather Configuration
WEATHER_API_KEY=sua_chave_weather_aqui

# Finance / Twelve Data Configuration
TWELVE_DATA_API_KEY=sua_chave_twelve_data_aqui

# Upstash Redis Configuration
UPSTASH_REDIS_REST_URL=sua_url_redis_aqui
UPSTASH_REDIS_REST_TOKEN=seu_token_redis_aqui

# Google Gemini Configuration
GEMINI_API_KEY=sua_chave_gemini_aqui

# ElevenLabs Configuration
ELEVENLABS_API_KEY=sua_chave_elevenlabs_aqui

# Google Maps Configuration
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# Smartcar Configuration
SMARTCAR_CLIENT_ID=seu_client_id_smartcar_aqui
SMARTCAR_CLIENT_SECRET=seu_client_secret_smartcar_aqui
SMARTCAR_MANAGEMENT_TOKEN=seu_management_token_smartcar_aqui
SMARTCAR_REDIRECT_URI=http://localhost:8000/callback/smartcar

# Sentry Configuration
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Environment
ENVIRONMENT=development
RELEASE=unbx-bot@4.29-god

# SmartThings Configuration
SMARTTHINGS_CLIENT_ID=seu_client_id_smartthings_aqui
SMARTTHINGS_CLIENT_SECRET=seu_client_secret_smartthings_aqui
SMARTTHINGS_REDIRECT_URI=http://localhost:8000/api/smartthings/callback

# Encryption
ENCRYPTION_KEY=sua_chave_de_encriptacao_aqui
