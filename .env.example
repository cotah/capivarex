# ===========================================
# SuperBot God - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to git!
# ===========================================

# OpenAI Configuration
OPENAI_API_KEY=sua_chave_openai_aqui

# Anthropic Configuration
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
CLAUDE_MODEL=claude-opus-4-5-20251101

# Perplexity / Sonar Configuration
SONAR_API_KEY=sua_chave_sonar_aqui

# GitHub Configuration
GITHUB_TOKEN=seu_token_github_aqui

# Telegram Configuration
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui
TELEGRAM_ADMIN_CHAT_ID=seu_chat_id_aqui

# Supabase Configuration
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua_chave_supabase_aqui

# JWT Configuration
JWT_SECRET_KEY=sua_chave_jwt_secreta_aqui
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Bot Credentials
BOT_EMAIL=seu_email_bot_aqui
BOT_PASSWORD=sua_senha_bot_aqui

# API Configuration
API_BASE_URL=http://localhost:8000

# Weather Configuration
WEATHER_API_KEY=sua_chave_weather_aqui

# Finance / Twelve Data Configuration
TWELVE_DATA_API_KEY=sua_chave_twelve_data_aqui

# Upstash Redis Configuration (REST API - used by main app)
UPSTASH_REDIS_REST_URL=sua_url_redis_aqui
UPSTASH_REDIS_REST_TOKEN=seu_token_redis_aqui

# Redis Configuration (socket connection - used by arq task queue worker)
REDIS_URL=redis://localhost:6379

# Google Gemini Configuration
GEMINI_API_KEY=sua_chave_gemini_aqui

# ElevenLabs Configuration
ELEVENLABS_API_KEY=sua_chave_elevenlabs_aqui

# Google Maps Configuration
GOOGLE_MAPS_API_KEY=sua_chave_google_maps_aqui

# Smartcar Configuration
SMARTCAR_CLIENT_ID=seu_client_id_smartcar_aqui
SMARTCAR_CLIENT_SECRET=seu_client_secret_smartcar_aqui
SMARTCAR_MANAGEMENT_TOKEN=seu_management_token_smartcar_aqui
SMARTCAR_REDIRECT_URI=http://localhost:8000/callback/smartcar

# Sentry Configuration
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Environment
ENVIRONMENT=development
RELEASE=unbx-bot@4.29-god

# SmartThings Configuration
SMARTTHINGS_CLIENT_ID=seu_client_id_smartthings_aqui
SMARTTHINGS_CLIENT_SECRET=seu_client_secret_smartthings_aqui
SMARTTHINGS_REDIRECT_URI=http://localhost:8000/api/smartthings/callback

# Encryption
ENCRYPTION_KEY=sua_chave_de_encriptacao_aqui

# -----------------------------------------------
# Twilio (SMS/Voice)
# -----------------------------------------------
TWILIO_ACCOUNT_SID=seu_twilio_account_sid_aqui
TWILIO_AUTH_TOKEN=seu_twilio_auth_token_aqui
TWILIO_WEBHOOK_BASE_URL=https://seu-dominio.com/api/webhooks/twilio

# ── Deepgram (Speech-to-Text for phone calls) ─────────
# Used for real-time call transcription (faster than Whisper for phone audio)
# If not set, falls back to Whisper
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── Twilio Intelligent Calls (Media Streams) ──────────
# Public HTTPS URL of the backend (Railway, etc.)
# Required for AI-powered phone calls (Twilio Media Streams)
# If not set, calls use static mode (TwiML <Say>)
BACKEND_URL=https://your-app.up.railway.app

# -----------------------------------------------
# Search (Serper)
# -----------------------------------------------
SERPER_API_KEY=sua_chave_serper_aqui

# -----------------------------------------------
# Google Places (Restaurants)
# -----------------------------------------------
GOOGLE_PLACES_API_KEY=sua_chave_google_places_aqui

# -----------------------------------------------
# Tracking (17Track)
# -----------------------------------------------
17TRACK_API_KEY=sua_chave_17track_aqui

# -----------------------------------------------
# Transit (NTA)
# -----------------------------------------------
NTA_API_KEY=sua_chave_nta_aqui

# -----------------------------------------------
# Google Calendar
# -----------------------------------------------
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# -----------------------------------------------
# Frontend (CORS)
# -----------------------------------------------
FRONTEND_URL=https://seu-frontend.up.railway.app
