# ===========================================
# CAPIVAREX - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the .env file to git!
# ===========================================

# -----------------------------------------------
# Core AI Services
# -----------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250514
SONAR_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
XAI_API_KEY=

# -----------------------------------------------
# Telegram
# -----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# -----------------------------------------------
# Supabase (Database)
# -----------------------------------------------
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# Supabase JWT public key coordinates (EC P-256) — obter em: Supabase Dashboard > Settings > API > JWT Settings
SUPABASE_JWT_JWK_X=your_jwk_x_value_here
SUPABASE_JWT_JWK_Y=your_jwk_y_value_here

# -----------------------------------------------
# Health Check Protection
# -----------------------------------------------
# Token para proteger o endpoint /api/health/detailed (deixe vazio para desabilitar proteção em dev)
HEALTH_CHECK_TOKEN=

# -----------------------------------------------
# Upstash Redis (REST API - used by main app)
# -----------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------
# Redis (TCP socket - used by arq task queue worker)
# Get the redis:// URL from Upstash dashboard
# -----------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------
# JWT Authentication
# -----------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# -----------------------------------------------
# Bot Credentials (webapp login)
# -----------------------------------------------
BOT_EMAIL=
BOT_PASSWORD=

# -----------------------------------------------
# Encryption
# -----------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------
# Google OAuth2 (Calendar + Gmail)
# -----------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# -----------------------------------------------
# Microsoft OAuth2 (Outlook + Calendar + Teams)
# -----------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# -----------------------------------------------
# Notion OAuth2 (Notes sync)
# -----------------------------------------------
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/api/auth/notion/callback

# -----------------------------------------------
# Google Maps / Places
# -----------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# -----------------------------------------------
# Google Vision OCR (used by mercado_service for receipts)
# -----------------------------------------------
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# -----------------------------------------------
# Spotify
# -----------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/spotify/callback

# -----------------------------------------------
# Stripe (Payments)
# -----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ME=
STRIPE_PRICE_EVERYWHERE=

# -----------------------------------------------
# Smartcar (Vehicle)
# -----------------------------------------------
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
SMARTCAR_MANAGEMENT_TOKEN=
SMARTCAR_REDIRECT_URI=http://localhost:8000/callback/smartcar

# -----------------------------------------------
# SmartThings (Smart Home)
# -----------------------------------------------
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=http://localhost:8000/api/smartthings/callback
# These are managed by OAuth flow, set manually only if migrating:
# SMARTTHINGS_ACCESS_TOKEN=
# SMARTTHINGS_REFRESH_TOKEN=

# -----------------------------------------------
# Twilio (Voice Calls)
# -----------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=https://seu-dominio.up.railway.app/api/webhooks/twilio
TWILIO_STREAM_BASE_URL=wss://seu-dominio.up.railway.app

# -----------------------------------------------
# Deepgram (Speech-to-Text for phone calls)
# Falls back to Whisper if not set
# -----------------------------------------------
DEEPGRAM_API_KEY=

# -----------------------------------------------
# Weather
# -----------------------------------------------
WEATHER_API_KEY=

# -----------------------------------------------
# Finance / Stocks
# -----------------------------------------------
TWELVE_DATA_API_KEY=

# -----------------------------------------------
# Search (Serper - Google Search)
# -----------------------------------------------
SERPER_API_KEY=

# -----------------------------------------------
# Travel (Duffel - Flights & Hotels)
# -----------------------------------------------
DUFFEL_API_TOKEN=

# -----------------------------------------------
# Package Tracking (17Track)
# -----------------------------------------------
17TRACK_API_KEY=

# -----------------------------------------------
# Public Transport (NTA Ireland)
# -----------------------------------------------
NTA_API_KEY=

# -----------------------------------------------
# YouTube
# -----------------------------------------------
YOUTUBE_API_KEY=

# -----------------------------------------------
# GitHub (Autofix + Dev Agent)
# -----------------------------------------------
GITHUB_TOKEN=

# -----------------------------------------------
# Sentry (Error Monitoring)
# -----------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.3

# -----------------------------------------------
# Frontend (CORS)
# -----------------------------------------------
FRONTEND_URL=https://seu-frontend.up.railway.app
BACKEND_URL=https://seu-backend.up.railway.app

# -----------------------------------------------
# Environment
# -----------------------------------------------
ENVIRONMENT=development
RELEASE=capivarex@4.29-god
