# ===========================================
# CapivaraX - Production Environment
# ===========================================
# Copy this file to .env.prod and fill in production values:
#   cp .env.prod.example .env.prod
#
# IMPORTANT: Never commit .env.prod to git!
# ===========================================

# --- Environment ---
ENVIRONMENT=production
RELEASE=capivarex@1.0.0

# --- OpenAI ---
OPENAI_API_KEY=

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5-20251101

# --- Perplexity / Sonar ---
SONAR_API_KEY=

# --- GitHub ---
GITHUB_TOKEN=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Bot Credentials ---
BOT_EMAIL=
BOT_PASSWORD=

# --- API ---
API_BASE_URL=https://your-production-domain.com

# --- Weather ---
WEATHER_API_KEY=

# --- Finance / Twelve Data ---
TWELVE_DATA_API_KEY=

# --- Upstash Redis (REST API - used by main app) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Redis (socket - used by arq task queue worker) ---
# On DigitalOcean App Platform, use the managed Redis URL
REDIS_URL=redis://localhost:6379

# --- Google Gemini ---
GEMINI_API_KEY=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Smartcar ---
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
SMARTCAR_MANAGEMENT_TOKEN=
SMARTCAR_REDIRECT_URI=https://your-production-domain.com/callback/smartcar

# --- Sentry ---
SENTRY_DSN=

# --- SmartThings ---
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=https://your-production-domain.com/api/smartthings/callback

# --- Deepgram (Speech-to-Text for phone calls) ---
# Used for real-time call transcription (faster than Whisper for phone audio)
# If not set, falls back to Whisper
DEEPGRAM_API_KEY=

# --- Encryption ---
ENCRYPTION_KEY=
