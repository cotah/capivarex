# ===========================================
# CAPIVAREX - Production Environment (Railway)
# ===========================================
# All variables that should be set in Railway.
# IMPORTANT: Never commit .env.prod to git!
# ===========================================

# --- Core AI Services ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250514
SONAR_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
XAI_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Upstash Redis (REST API - main app) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Redis (TCP socket - arq worker) ---
REDIS_URL=

# --- JWT ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Bot Credentials ---
BOT_EMAIL=
BOT_PASSWORD=

# --- Encryption ---
ENCRYPTION_KEY=

# --- Google OAuth2 (Calendar + Gmail) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Google Maps / Places ---
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Google Vision OCR ---
GOOGLE_CREDENTIALS_JSON=

# --- Spotify ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# --- Stripe (Payments) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ME=
STRIPE_PRICE_EVERYWHERE=

# --- Smartcar ---
SMARTCAR_CLIENT_ID=
SMARTCAR_CLIENT_SECRET=
SMARTCAR_MANAGEMENT_TOKEN=
SMARTCAR_REDIRECT_URI=

# --- SmartThings ---
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_REDIRECT_URI=
SMARTTHINGS_ACCESS_TOKEN=
SMARTTHINGS_REFRESH_TOKEN=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_STREAM_BASE_URL=

# --- Deepgram ---
DEEPGRAM_API_KEY=

# --- Weather ---
WEATHER_API_KEY=

# --- Finance ---
TWELVE_DATA_API_KEY=

# --- Search ---
SERPER_API_KEY=

# --- Travel ---
DUFFEL_API_TOKEN=

# --- Tracking ---
17TRACK_API_KEY=

# --- Transit ---
NTA_API_KEY=

# --- YouTube ---
YOUTUBE_API_KEY=

# --- GitHub ---
GITHUB_TOKEN=

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.3

# --- Frontend / Backend URLs ---
FRONTEND_URL=
BACKEND_URL=

# --- Environment ---
ENVIRONMENT=production
RELEASE=capivarex@4.29-god
